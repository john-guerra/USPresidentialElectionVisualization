{
  "name": "us-election-results",
  "version": "1.0.0",
  "description": "Scrollytelling visualization of US presidential election results by county, 2000-2024",
  "main": "index.html",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "pug": "^3.0.4"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint js/ scripts/",
    "format": "prettier --write \"{js,scripts}/**/*.{js,mjs}\" \"css/main.css\" \"css/scroller.css\" index.jade",
    "check": "npm run lint && npm run build"
  },
